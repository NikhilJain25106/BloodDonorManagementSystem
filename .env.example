# ==========================================
# LifeDrop - Environment Configuration
# Copy this file to .env for local overrides
# ==========================================

# Server Port (default: 8080)
PORT=8080

# Database Configuration (Railway or Local MySQL)
# Option 1: Individual connection parameters
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=blood_donor_db
MYSQLUSER=root
MYSQLPASSWORD=your_password_here

# Option 2: Full MySQL Connection URL (Used on Railway or PaaS platforms)
# Format: mysql://user:password@host:port/database
# MYSQL_URL=mysql://root:password@localhost:3306/blood_donor_db
