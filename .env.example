# =============================================================================
# LifeDrop - Environment Configuration
# Copy this file to .env to customize settings for your device
# =============================================================================

# HTTP Server Port (default: 8080)
PORT=8080

# -----------------------------------------------------------------------------
# Aiven Cloud MySQL (Fill with your credentials)
# -----------------------------------------------------------------------------
MYSQLHOST=your-aiven-host.aivencloud.com
MYSQLPORT=22772
MYSQLDATABASE=defaultdb
MYSQLUSER=avnadmin
MYSQLPASSWORD=your_password_here
