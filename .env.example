# =============================================================================
# LifeDrop - Environment Configuration
# Copy this file to .env to customize settings for your device
# =============================================================================

# HTTP Server Port (default: 8080)
PORT=8080

# -----------------------------------------------------------------------------
# Option A: Running with Docker Compose (Automatic defaults - No edits needed!)
# -----------------------------------------------------------------------------
# MYSQLHOST=db
# MYSQLPORT=3306
# MYSQLDATABASE=blood_donor_db
# MYSQLUSER=lifedrop
# MYSQLPASSWORD=lifedroppassword
# MYSQL_ROOT_PASSWORD=rootpassword

# -----------------------------------------------------------------------------
# Option B: Running Locally Native (Host MySQL)
# -----------------------------------------------------------------------------
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=blood_donor_db
MYSQLUSER=root
MYSQLPASSWORD=your_mysql_password_here

# -----------------------------------------------------------------------------
# Option C: Cloud Database URL (Railway / Render / AWS RDS)
# -----------------------------------------------------------------------------
# Format: mysql://user:password@host:port/database
# MYSQL_URL=mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
